# Leave both Supabase values unset to use webapp/data/companies.json locally.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Generate once for production and store it as a hosting secret. Changing it
# signs every browser and iPhone session out.
SESSION_SECRET=replace-with-at-least-32-random-characters

NODE_ENV=production
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
PORT=8090
# DATA_DIR=/persistent/path/panelvault
