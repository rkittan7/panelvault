# Leave both Supabase values unset to use webapp/data/companies.json locally.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Generate once for production and store it as a hosting secret. Changing it
# signs every browser and iPhone session out.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Server-side only. Create a key in Google AI Studio; never put it in app or
# browser code. GEMINI_MODEL is optional.
GEMINI_API_KEY=replace-with-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash

NODE_ENV=production
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
PORT=8090
# DATA_DIR=/persistent/path/panelvault
